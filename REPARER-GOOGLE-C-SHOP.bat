@echo off
setlocal
cd /d "%~dp0"

if not exist "functions\api\auth\.." (
  echo ERREUR : place ce fichier a la racine du dossier cshopfrance, puis relance-le.
  pause
  exit /b 1
)

echo Reparation des routes Google en cours...
if exist "functions\api\auth\google.js" del /f /q "functions\api\auth\google.js"
if exist "functions\api\auth\Google" rmdir /s /q "functions\api\auth\Google"
if exist "functions\api\auth\google" rmdir /s /q "functions\api\auth\google"
mkdir "functions\api\auth\google"

powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes('functions\api\auth\google\[[path]].js',[Convert]::FromBase64String(''))"

echo.
echo TERMINE : Google a ete repare.
echo Retourne maintenant dans GitHub Desktop : tu verras les fichiers modifies.
echo Fais Commit to main puis Push origin.
pause
